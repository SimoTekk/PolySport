@model PolySport.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

@* Die Kennzahlen sind offen. Ohne Anmeldung fehlen nur die Schaltflächen,
   die auf geschützte Seiten führen – dort käme sonst die Anmeldemaske. *@
<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <div>
        <h2 class="mb-0">Dashboard</h2>
        @if (Model.HasActiveSeason)
        {
            <span class="text-muted">Saison @Model.SeasonName</span>
        }
    </div>
    @if (isAdmin && Model.PendingApprovals > 0)
    {
        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-danger">
            @Model.PendingApprovals Registrierung(en) warten auf Freigabe
        </a>
    }
</div>

@if (!isAuthenticated)
{
    <p class="text-muted">
        Matches, Torfolgen und die vollständige Auswertung gibt es nach der
        Anmeldung – oben rechts, dort geht auch die Registrierung.
    </p>
}

@if (!Model.HasActiveSeason)
{
    @if (isAuthenticated)
    {
        <div class="alert alert-warning">
            Es ist keine Saison aktiv. Setze unter <a asp-controller="Seasons" asp-action="Index">Saisons</a>
            eine Saison auf aktiv, damit Matches erfasst und ausgewertet werden können.
        </div>
    }
    else
    {
        <div class="alert alert-secondary">
            Zurzeit ist keine Saison aktiv, darum gibt es noch keine Zahlen zu zeigen.
        </div>
    }
}
else
{
    <div class="row g-3">

        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Bilanz</h6>
                    <p class="display-6 mb-1">@Model.Wins - @Model.Draws - @Model.Losses</p>
                    <p class="card-text text-muted mb-0">Siege - Unentschieden - Niederlagen</p>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Torverhältnis</h6>
                    <p class="display-6 mb-1">@Model.GoalsFor : @Model.GoalsAgainst</p>
                    <p class="card-text mb-0">
                        <span class="badge @(Model.GoalDifference >= 0 ? "bg-success" : "bg-danger")">
                            @(Model.GoalDifference > 0 ? "+" : "")@Model.GoalDifference
                        </span>
                        <span class="text-muted ms-1">Differenz</span>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Spiele</h6>
                    <p class="display-6 mb-1">@Model.MatchesFinished / @Model.MatchesTotal</p>
                    <p class="card-text text-muted mb-0">beendet@(Model.MatchesOpen > 0 ? $", {Model.MatchesOpen} offen" : "")</p>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted text-uppercase small mb-2">Kader</h6>
                    <p class="display-6 mb-1">@Model.ActivePlayers</p>
                    <p class="card-text text-muted mb-0">aktive Spieler</p>
                </div>
            </div>
        </div>

        @if (Model.OpenMatch != null)
        {
            <div class="col-lg-6">
                <div class="card h-100 border-primary">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>@(Model.OpenMatch.HasStarted ? "Offenes Match" : "Nächstes Match")</span>
                        <span class="badge @(Model.OpenMatch.IsPeriodRunning ? "bg-success" : "bg-secondary")">
                            @Model.OpenMatch.StatusLabel
                        </span>
                    </div>
                    <div class="card-body">
                        <h4 class="card-title mb-1">gegen @Model.OpenMatch.OpponentName</h4>
                        <p class="text-muted">@Model.OpenMatch.MatchDate.ToString("dd.MM.yyyy HH:mm")</p>
                        <p class="display-6 mb-3">@Model.OpenMatch.OurScore : @Model.OpenMatch.OpponentScore</p>
                        @if (isAuthenticated)
                        {
                            <a asp-controller="Matches" asp-action="Details" asp-route-id="@Model.OpenMatch.Id"
                               class="btn btn-primary">Zum Match</a>
                        }
                    </div>
                </div>
            </div>
        }

        @if (Model.LastMatch != null)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header">Letztes Resultat</div>
                    <div class="card-body">
                        <h4 class="card-title mb-1">gegen @Model.LastMatch.OpponentName</h4>
                        <p class="text-muted">@Model.LastMatch.MatchDate.ToString("dd.MM.yyyy")</p>
                        <p class="display-6 mb-2">@Model.LastMatch.OurScore : @Model.LastMatch.OpponentScore</p>
                        <p>
                            @{
                                var resultClass = Model.LastMatch.ResultLabel == "Sieg" ? "bg-success"
                                    : Model.LastMatch.ResultLabel == "Niederlage" ? "bg-danger" : "bg-secondary";
                            }
                            <span class="badge @resultClass">@Model.LastMatch.ResultLabel</span>
                        </p>
                        @if (isAuthenticated)
                        {
                            <a asp-controller="Matches" asp-action="Details" asp-route-id="@Model.LastMatch.Id"
                               class="btn btn-outline-primary">Details</a>
                        }
                    </div>
                </div>
            </div>
        }

        @* Aufgebot: die Angabe, nach der vor dem Spiel gefragt wird. Steht
           bewusst auch ohne Anmeldung da und lässt sich als Ganzes kopieren. *@
        @if (Model.Lineup != null)
        {
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span>Aufgebot</span>
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-copy-text="@Model.Lineup.ShareText">Text kopieren</button>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-3">
                            @Model.Lineup.MatchDate.ToString("dd.MM.yyyy HH:mm") gegen @Model.Lineup.OpponentName
                            @if (Model.Lineup.IsHomeGame.HasValue)
                            {
                                <span class="badge @(Model.Lineup.IsHomeGame.Value ? "bg-primary" : "bg-secondary") ms-1">@Model.Lineup.VenueLabel</span>
                            }
                        </p>
                        <p class="mb-2">
                            <strong>Torhüter:</strong>
                            @(Model.Lineup.GoalkeeperName ?? "noch offen")
                        </p>
                        <p class="mb-1"><strong>Feldspieler (@Model.Lineup.FieldPlayerCount)</strong></p>
                        @if (Model.Lineup.FieldPlayers.Any())
                        {
                            <p class="mb-0">@string.Join(", ", Model.Lineup.FieldPlayers)</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Für dieses Match ist noch kein Kader erfasst.</p>
                        }
                    </div>
                </div>
            </div>
        }

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Scorer</span>
                    @if (isAuthenticated)
                    {
                        <a asp-controller="Statistics" asp-action="Season" class="small">alle anzeigen</a>
                    }
                </div>
                @if (Model.Scorers.Any())
                {
                    <ul class="list-group list-group-flush">
                        @{ var rank = 1; }
                        @foreach (var scorer in Model.Scorers)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><strong>@rank.</strong> @scorer.PlayerName</span>
                                <span>
                                    <span class="text-muted small me-2">@scorer.Goals T / @scorer.Assists A</span>
                                    <span class="badge bg-primary rounded-pill">@scorer.TotalPoints</span>
                                </span>
                            </li>
                            rank++;
                        }
                    </ul>
                }
                else
                {
                    <div class="card-body text-muted">Noch keine Tore in dieser Saison erfasst.</div>
                }
            </div>
        </div>

        @* Präsenzliste: wer war wie oft dabei. Nur beendete Spiele zählen,
           darum steht die Zahl der beendeten Spiele als Bezugsgrösse dabei. *@
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Präsenzliste</span>
                    <span class="small text-muted">
                        @Model.MatchesFinished beendete@(Model.MatchesFinished == 1 ? "s Spiel" : " Spiele")
                    </span>
                </div>
                @if (Model.Presence.Any())
                {
                    <ul class="list-group list-group-flush presence-list">
                        @foreach (var entry in Model.Presence)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    @entry.PlayerName
                                    @if (!entry.IsActive)
                                    {
                                        <span class="badge bg-secondary ms-1">inaktiv</span>
                                    }
                                    @if (entry.GoalkeeperAppearances > 0)
                                    {
                                        <span class="badge bg-info-subtle text-body-secondary border ms-1"
                                              title="Einsätze im Tor">@entry.GoalkeeperAppearances× Tor</span>
                                    }
                                </span>
                                <span class="badge bg-primary rounded-pill">
                                    @entry.Appearances / @Model.MatchesFinished
                                </span>
                            </li>
                        }
                    </ul>
                    <div class="card-footer small text-muted">
                        Einsätze aus beendeten Spielen. Ein Kader für einen noch
                        offenen Termin zählt nicht mit.
                    </div>
                }
                else
                {
                    <div class="card-body text-muted">Für diese Saison ist noch kein Spieler erfasst.</div>
                }
            </div>
        </div>

    </div>
}
