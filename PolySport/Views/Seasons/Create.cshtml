@model PolySport.Models.Season
@{
    ViewData["Title"] = "Saison erstellen";
}

<h2>Neue Saison anlegen</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" placeholder="z.B. Saison 2026/27" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group form-check mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Speichern" class="btn btn-success" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Zurück</a>
            </div>
        </form>
    </div>
</div>