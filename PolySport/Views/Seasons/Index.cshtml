@model IEnumerable<PolySport.Models.Season>
@{
    ViewData["Title"] = "Saisons";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <h2>Saisons verwalten</h2>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">📅 Neue Saison anlegen</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Status</th>
                @if (isAdmin)
                {
                    <th class="text-end">Aktion</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktiv</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inaktiv</span>
                        }
                    </td>
                    @if (isAdmin)
                    {
                        <td class="text-end">
                            @if (!item.IsActive)
                            {
                                <form asp-action="Activate" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">Aktiv setzen</button>
                                </form>
                            }
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">✏️ Bearbeiten</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">🗑️ Löschen</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Noch keine Saison angelegt.</div>
}
