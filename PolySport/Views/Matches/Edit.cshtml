@model PolySport.Models.ViewModels.EditMatchViewModel
@{
    ViewData["Title"] = "Match bearbeiten";
}

@* Select2 wird nur bei offenem Kader gebraucht; ein @section darf aber nicht
   in einer Bedingung stehen, darum das Stylesheet immer einbinden. *@
@section VendorStyles {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<h2>Match bearbeiten</h2>
<hr />

<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group mb-3">
                <label asp-for="SeasonId" class="control-label"></label>
                <select asp-for="SeasonId" class="form-select" asp-items="Model.AvailableSeasons"></select>
                <span asp-validation-for="SeasonId" class="text-danger"></span>
                @if (Model.GoalCount > 0)
                {
                    <div class="form-text">
                        An diesem Match hängen @Model.GoalCount Tore. Ein Wechsel der
                        Saison verschiebt sie in die Statistik der neuen Saison.
                    </div>
                }
            </div>

            <div class="form-group mb-3">
                <label asp-for="OpponentName" class="control-label"></label>
                <input asp-for="OpponentName" class="form-control" placeholder="z.B. SC Bern" />
                <span asp-validation-for="OpponentName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MatchDate" class="control-label"></label>
                <input asp-for="MatchDate" class="form-control" type="datetime-local" />
                <span asp-validation-for="MatchDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IsHomeGame" class="control-label"></label>
                <select asp-for="IsHomeGame" class="form-select">
                    <option value="">-- keine Angabe --</option>
                    <option value="true">Heimspiel</option>
                    <option value="false">Auswärtsspiel</option>
                </select>
                <span asp-validation-for="IsHomeGame" class="text-danger"></span>
            </div>

            @if (Model.CanEditRoster)
            {
                <div class="form-group mb-4">
                    <label asp-for="SelectedPlayerIds" class="control-label">Spieler im Kader (Tippen zum Suchen)</label>
                    <select asp-for="SelectedPlayerIds" class="form-control select2-multiple" asp-items="Model.AvailablePlayers" multiple="multiple">
                    </select>
                    <span asp-validation-for="SelectedPlayerIds" class="text-danger"></span>
                    <div class="form-text">
                        Änderbar, solange das Match nicht gestartet ist. Nach dem
                        Start des 1. Drittels bleibt der Kader fest.
                    </div>
                </div>
            }
            else
            {
                <div class="form-group mb-4">
                    <label class="control-label">Spieler im Kader</label>
                    <div class="form-control-plaintext">
                        @(Model.RosterNames.Any() ? string.Join(", ", Model.RosterNames) : "Kein Kader erfasst.")
                    </div>
                    <div class="form-text">
                        Das Match ist gestartet – der Kader lässt sich nicht mehr
                        ändern, weil Einsätze und Tore daran hängen.
                    </div>
                </div>
            }

            <div class="form-group">
                <input type="submit" value="Speichern" class="btn btn-success" />
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary ms-2">Abbrechen</a>
            </div>
        </form>

        <p class="text-muted small mt-4 mb-0">
            Tore werden hier nicht verändert. Die lassen sich auf der Detailseite
            einzeln löschen und neu erfassen.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (Model.CanEditRoster)
    {
        @* jQuery kommt bereits aus dem Layout – ein zweites Laden würde die
           vorher registrierte Validierung an eine andere jQuery-Instanz hängen. *@
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

        <script>
            $(document).ready(function () {
                $('.select2-multiple').select2({
                    placeholder: "Spieler suchen und auswählen...",
                    allowClear: true,
                    width: '100%'
                });
            });
        </script>
    }
}
