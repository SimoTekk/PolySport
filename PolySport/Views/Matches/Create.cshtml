@model PolySport.Models.ViewModels.CreateMatchViewModel

@{
    ViewData["Title"] = "Neues Match anlegen";
}

<h2>Neues Match anlegen</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="SeasonId" class="control-label"></label>
                <select asp-for="SeasonId" class="form-select" asp-items="Model.AvailableSeasons">
                    <option value="">-- Bitte Saison wählen --</option>
                </select>
                <span asp-validation-for="SeasonId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="OpponentName" class="control-label"></label>
                <input asp-for="OpponentName" class="form-control" placeholder="z.B. SC Bern" />
                <span asp-validation-for="OpponentName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MatchDate" class="control-label"></label>
                <input asp-for="MatchDate" class="form-control" type="date" />
                <span asp-validation-for="MatchDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="IsHomeGame" class="control-label"></label>
                <select asp-for="IsHomeGame" class="form-select">
                    <option value="">-- keine Angabe --</option>
                    <option value="true">Heimspiel</option>
                    <option value="false">Auswärtsspiel</option>
                </select>
                <span asp-validation-for="IsHomeGame" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="SelectedPlayerIds" class="control-label"></label>
                <partial name="_RosterPicker" model="Model.Picker" />
                <span asp-validation-for="SelectedPlayerIds" class="text-danger"></span>
                <span asp-validation-for="GoalkeeperId" class="text-danger"></span>
                <div class="form-text">
                    Der Kader darf leer bleiben: am Saisonanfang lassen sich so
                    zuerst alle Termine anlegen. Vor dem Spiel wird er unter
                    „Match bearbeiten“ nachgetragen.
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Match Speichern" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary ms-2">Abbrechen</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
