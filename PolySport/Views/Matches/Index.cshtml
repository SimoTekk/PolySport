@model IEnumerable<PolySport.Models.Match>

@{
    ViewData["Title"] = "Match Übersicht";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>Match Historie</h2>
    <a asp-action="Create" class="btn btn-primary">🏒 Neues Match anlegen</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Datum</th>
                    <th>Saison</th>
                    <th>Gegner</th>
                    <th>Gegner Tore</th>
                    <th class="text-end">Aktion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.MatchDate.ToString("dd.MM.yyyy HH:mm")</strong></td>
                        <td>@item.Season?.Name</td>
                        <td>@item.OpponentName</td>
                        <td>@item.OpponentScore</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-bold">
                                🔍 Details / Tore eintragen
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning text-center">
        Es wurden noch keine Matches angelegt. Starte jetzt die Saison!
    </div>
}