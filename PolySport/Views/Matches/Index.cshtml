@model IEnumerable<PolySport.Models.Match>

@{
    ViewData["Title"] = "Match Übersicht";
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2>Match Historie</h2>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">Neues Match anlegen</a>
    }
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Datum</th>
                    <th>Saison</th>
                    <th>Gegner</th>
                    <th class="text-center">Resultat</th>
                    <th>Status</th>
                    <th class="text-end">Aktion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.MatchDate.ToString("dd.MM.yyyy HH:mm")</strong></td>
                        <td>@item.Season?.Name</td>
                        <td>@item.OpponentName</td>
                        <td class="text-center fw-bold">@item.OurScore : @item.OpponentScore</td>
                        <td>
                            @if (item.IsFinished)
                            {
                                @if (item.OurScore > item.OpponentScore)
                                {
                                    <span class="badge bg-success">Sieg</span>
                                }
                                else if (item.OurScore < item.OpponentScore)
                                {
                                    <span class="badge bg-danger">Niederlage</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Unentschieden</span>
                                }
                            }
                            else if (item.IsPeriodRunning)
                            {
                                <span class="badge bg-success">@item.CurrentPeriod. Drittel läuft</span>
                            }
                            else if (item.HasStarted)
                            {
                                <span class="badge bg-secondary">@item.StatusLabel</span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">Nicht gestartet</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white fw-bold">
                                Details@(isAdmin && !item.IsFinished ? " / Spiel steuern" : "")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning text-center">
        Es wurden noch keine Matches angelegt. Starte jetzt die Saison!
    </div>
}
