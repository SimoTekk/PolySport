@model IEnumerable<PolySport.Models.User>
@{
    ViewData["Title"] = "Spieler";
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var activeCount = Model.Count(p => p.IsActive);
    var inactiveCount = Model.Count() - activeCount;
}

<div class="d-flex justify-content-between align-items-center mb-3 mt-3">
    <div>
        <h2 class="mb-0">Spieler verwalten</h2>
        <span class="text-muted">@activeCount aktiv, @inactiveCount inaktiv</span>
    </div>
    @if (isAdmin)
    {
        <a asp-action="Create" class="btn btn-primary">Neuen Spieler anlegen</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<p class="text-muted">
    Nur aktive Spieler lassen sich bei einem neuen Match als Kader auswählen.
    Inaktive Spieler bleiben in bereits erfassten Matches, Kadern und Toren erhalten.
</p>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Status</th>
                @if (isAdmin)
                {
                    <th class="text-end">Aktion</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Username</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Aktiv</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inaktiv</span>
                        }
                    </td>
                    @if (isAdmin)
                    {
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Bearbeiten</a>
                            @if (item.IsActive)
                            {
                                <form asp-action="SetActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <input type="hidden" name="active" value="false" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Inaktiv setzen</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="SetActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <input type="hidden" name="active" value="true" />
                                    <button type="submit" class="btn btn-sm btn-success">Aktiv setzen</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Noch keine Spieler angelegt.</div>
}
