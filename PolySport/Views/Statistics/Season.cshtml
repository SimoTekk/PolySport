@model PolySport.Models.ViewModels.SeasonStatsViewModel

@{
    ViewData["Title"] = "Saison Statistik";
    int rank = 1; // Zähler für den Tabellenplatz
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Top Scorer</h1>
        <h4 class="text-muted">@Model.SeasonName</h4>
        <a asp-action="Sheet" asp-route-id="@Model.SeasonId" class="btn btn-sm btn-outline-primary mt-2">
            Saisonblatt: Tore und Assists pro Match
        </a>
    </div>

    @if (Model.PlayerStats.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover shadow-sm">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 10%;">Rang</th>
                        <th>Spieler</th>
                        <th class="text-center">Tore</th>
                        <th class="text-center">Assists</th>
                        <th class="text-center text-warning">Punkte</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var stat in Model.PlayerStats)
                    {
                        <tr>
                            <td>
                                @if (rank == 1)
                                {
                                    <span>🥇 1</span>
                                }
                                else if (rank == 2)
                                {

                                    <span>🥈 2</span>
                                }
                                else if (rank == 3)
                                {

                                    <span>🥉 3</span>
                                }
                                else
                                {

                                    <strong>#@rank</strong>
                                }
                            </td>
                            <td><strong class="text-primary">@stat.PlayerName</strong></td>
                            <td class="text-center">@stat.Goals</td>
                            <td class="text-center">@stat.Assists</td>
                            <td class="text-center"><strong>@stat.TotalPoints</strong></td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            In dieser Saison wurden noch keine Tore erzielt. Spielt gefälligst offensiver!
        </div>
    }

    <h2 class="mt-5 mb-3">Auswertung: wann fallen die Tore?</h2>

    @if (Model.TotalGoalsFor + Model.TotalGoalsAgainst == 0)
    {
        <div class="alert alert-info">Noch keine Tore mit Zeitangabe erfasst.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 12%;">Drittel</th>
                        <th class="text-center" style="width: 10%;">Wir</th>
                        <th class="text-center" style="width: 10%;">Gegner</th>
                        <th>Verteilung</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var period in Model.PeriodStats)
                    {
                        <tr>
                            <td><strong>@period.Label</strong></td>
                            <td class="text-center">@period.GoalsFor</td>
                            <td class="text-center">@period.GoalsAgainst</td>
                            <td>
                                @* Balkenbreite relativ zum grössten Einzelwert *@
                                @{
                                    var peak = Model.PeriodPeak == 0 ? 1 : Model.PeriodPeak;
                                    var forWidth = period.GoalsFor * 100 / peak;
                                    var againstWidth = period.GoalsAgainst * 100 / peak;
                                }
                                <div class="d-flex align-items-center mb-1">
                                    <small class="text-muted me-2" style="width: 3.5rem;">Wir</small>
                                    <div class="progress flex-grow-1" style="height: 12px;" role="img"
                                         aria-label="@period.GoalsFor eigene Tore im @period.Label">
                                        <div class="progress-bar bg-success" style="width: @forWidth%;"></div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center">
                                    <small class="text-muted me-2" style="width: 3.5rem;">Gegner</small>
                                    <div class="progress flex-grow-1" style="height: 12px;" role="img"
                                         aria-label="@period.GoalsAgainst Gegentore im @period.Label">
                                        <div class="progress-bar bg-danger" style="width: @againstWidth%;"></div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td>Total</td>
                        <td class="text-center">@Model.TotalGoalsFor</td>
                        <td class="text-center">@Model.TotalGoalsAgainst</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        @if (Model.GoalsWithoutTime + Model.GoalsAgainstWithoutTime > 0)
        {
            <p class="text-muted">
                Ohne Zeitangabe erfasst: @Model.GoalsWithoutTime eigene Tore und
                @Model.GoalsAgainstWithoutTime Gegentore. Sie fehlen in der Verteilung,
                sind im Total aber mitgezählt.
            </p>
        }
    }
</div>