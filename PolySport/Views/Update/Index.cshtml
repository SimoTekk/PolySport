@model PolySport.Models.ViewModels.UpdatePageViewModel
@using PolySport.Services
@{
    ViewData["Title"] = "Aktualisierung";
    var info = Model.Info;
    var status = Model.Status;
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="mb-0">Aktualisierung</h2>
    <a asp-action="Index" class="btn btn-sm btn-outline-primary">Erneut prüfen</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small mb-2">Installiert</h6>
                <p class="display-6 mb-0">@info.CurrentVersion</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100 @(info.IsUpdateAvailable ? "border-primary" : "")">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small mb-2">Verfügbar</h6>
                <p class="display-6 mb-0">@(info.LatestVersion ?? "–")</p>
                @if (info.CheckedAt.HasValue)
                {
                    <p class="text-muted small mb-0 mt-2">
                        geprüft am @info.CheckedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </p>
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(info.Error))
{
    <div class="alert alert-warning mt-3">
        Die Versionsprüfung war nicht möglich: @info.Error.
        @if (!string.IsNullOrEmpty(Model.RepositoryUrl))
        {
            <span>
                Ist das Repository <a href="@Model.RepositoryUrl" target="_blank" rel="noopener">@Model.RepositoryUrl</a>
                öffentlich erreichbar?
            </span>
        }
    </div>
}

@* Änderungen zwischen installierter und neuester Version *@
@if (info.IsUpdateAvailable && Model.PendingChanges.Any())
{
    <div class="card mt-4">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Was sich ändert</span>
            <span class="text-muted small">
                @if (Model.VersionsBehind == 1)
                {
                    <span>eine neue Version</span>
                }
                else
                {
                    <span>@Model.VersionsBehind neue Versionen seit @info.CurrentVersion</span>
                }
            </span>
        </div>
        <div class="card-body">
            @foreach (var entry in Model.PendingChanges)
            {
                <div class="mb-4">
                    <h5 class="mb-1">
                        @entry.Version
                        @if (!string.IsNullOrEmpty(entry.Date))
                        {
                            <span class="text-muted fs-6 fw-normal">– @entry.Date</span>
                        }
                    </h5>
                    @if (entry.Items.Any())
                    {
                        <ul class="mb-0">
                            @foreach (var item in entry.Items)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Keine Einzelheiten hinterlegt.</p>
                    }
                </div>
            }
        </div>
    </div>
}
else if (info.IsUpdateAvailable)
{
    <p class="text-muted mt-4">
        Zu dieser Version ist keine Änderungsliste hinterlegt.
        @if (!string.IsNullOrEmpty(Model.RepositoryUrl))
        {
            <a href="@Model.RepositoryUrl/blob/master/CHANGELOG.md" target="_blank" rel="noopener">Änderungen auf GitHub ansehen</a>
        }
    </p>
}

@if (Model.IsUpdateRunning)
{
    <div class="card mt-4" id="updateProgress" data-poll-url="@Url.Action("Status")">
        <div class="card-body">
            <div class="d-flex align-items-center gap-3">
                <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                <div>
                    <strong id="updateStateText">Update läuft</strong>
                    <div class="text-muted small" id="updateMessage">@status.Message</div>
                </div>
            </div>
            <hr />
            <p class="text-muted small mb-0">
                Die Anwendung wird neu gebaut und startet dabei neu. Das dauert
                je nach Server einige Minuten – diese Seite ist kurz nicht
                erreichbar und meldet sich von selbst zurück.
            </p>
        </div>
    </div>
}
else if (status.State == UpdateState.Success)
{
    <div class="alert alert-success mt-4">
        <div>
            <strong>Letztes Update erfolgreich.</strong>
            @if (!string.IsNullOrEmpty(status.Version))
            {
                <span>Version @status.Version</span>
            }
            @if (status.UpdatedAt.HasValue)
            {
                <span class="text-muted">(@status.UpdatedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(status.Message))
        {
            @* Kann einen Hinweis enthalten, etwa dass der Port nicht erreichbar war *@
            <div class="small mt-1">@status.Message</div>
        }
    </div>
}
else if (status.State == UpdateState.Stale)
{
    <div class="alert alert-warning mt-4">
        <strong>Der Update-Vorgang meldet sich nicht mehr.</strong>
        <p class="mb-2 mt-2">
            Letzte Meldung
            @if (status.Age.HasValue)
            {
                <span>vor @((int)status.Age.Value.TotalMinutes) Minuten</span>
            }
            : @status.Message
        </p>
        <p class="mb-3 small">
            Vermutlich ist der Dienst auf dem Host abgebrochen, ohne einen Abschluss
            zu schreiben. Prüfen lässt sich das auf dem Server mit
            <code>systemctl status polysport-update</code> und
            <code>journalctl -u polysport-update</code>. Läuft die Anwendung in der
            erwarteten Version, ist das Update durchgelaufen und nur die Meldung
            blieb hängen.
        </p>
        <form asp-action="ClearStatus" method="post">
            <button type="submit" class="btn btn-sm btn-outline-primary">Meldung zurücksetzen</button>
        </form>
    </div>
}
else if (status.State == UpdateState.Failed)
{
    <div class="alert alert-danger mt-4">
        <strong>Das letzte Update ist fehlgeschlagen.</strong>
        <div>@status.Message</div>
        <hr />
        <p class="mb-3 small">
            Die vorherige Version läuft weiter. Protokoll auf dem Server ansehen mit
            <code>journalctl -u polysport-update</code> beziehungsweise
            <code>cd /opt/polysport &amp;&amp; docker compose logs</code>.
        </p>
        <form asp-action="ClearStatus" method="post">
            <button type="submit" class="btn btn-sm btn-outline-primary">Meldung zurücksetzen</button>
        </form>
    </div>
}

<div class="mt-4">
    @if (info.IsUpdateAvailable && !Model.IsUpdateRunning)
    {
        @if (Model.CanInstall)
        {
            <form asp-action="Install" method="post"
                  onsubmit="return confirm('Update auf @info.LatestVersion jetzt installieren? Die Datenbank wird vorher gesichert, die Seite ist kurz nicht erreichbar.');">
                <button type="submit" class="btn btn-primary btn-lg">
                    Update auf @info.LatestVersion installieren
                </button>
            </form>
            <p class="text-muted small mt-2 mb-0">
                Vor dem Update wird die Datenbank gesichert. Schlägt der Bau fehl,
                läuft die bisherige Version unverändert weiter.
            </p>
        }
        else
        {
            <div class="alert alert-info">
                <strong>Neue Version verfügbar: @info.LatestVersion</strong>
                <p class="mb-2 mt-2">
                    Diese Installation kann sich nicht selbst aktualisieren – das
                    geht nur bei der Einrichtung über <code>deploy/install.sh</code>.
                    Auf dem Server ausführen:
                </p>
                <pre class="mb-0"><code>bash /opt/polysport/deploy/update.sh</code></pre>
            </div>
        }
    }
    else if (!info.IsUpdateAvailable && string.IsNullOrEmpty(info.Error) && !Model.IsUpdateRunning)
    {
        <div class="alert alert-success mb-0">Die Anwendung ist auf dem neuesten Stand.</div>
    }
</div>

@if (!string.IsNullOrEmpty(Model.RepositoryUrl))
{
    <p class="text-muted small mt-4">
        Quelle: <a href="@Model.RepositoryUrl" target="_blank" rel="noopener">@Model.RepositoryUrl</a>
        &middot; <a href="@Model.RepositoryUrl/blob/master/CHANGELOG.md" target="_blank" rel="noopener">alle Änderungen</a>
    </p>
}
