@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PolySport.Services
@inject UserManager<ApplicationUser> UserManager
@inject IUpdateService UpdateService
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var pendingApprovals = isAdmin
        ? await UserManager.Users.CountAsync(u => !u.IsApproved)
        : 0;

    // Nur der zwischengespeicherte Stand – die Prüfung läuft im Hintergrund,
    // damit der Seitenaufbau nicht auf GitHub warten muss.
    var updateInfo = isAdmin ? UpdateService.Cached : null;
    var updateAvailable = updateInfo?.IsUpdateAvailable == true;

    // Aktive Seite in der Menüleiste hervorheben. Der Controller allein
    // genügt nicht: Top-Scorer und Saisonblatt teilen sich Statistics,
    // darum entscheidet dort zusätzlich die Aktion.
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var routeAction = ViewContext.RouteData.Values["action"]?.ToString();

    bool IsOn(string controller, string? action = null) =>
        routeController == controller && (action is null || routeAction == action);

    // Ein Tor wird immer aus einem Match heraus erfasst, darum bleibt
    // dabei der Punkt Matches hervorgehoben.
    var onHome = IsOn("Home", "Index");
    var onMatches = IsOn("Matches") || IsOn("Goals");
    var onTopScorer = IsOn("Statistics", "Season");
    var onSheet = IsOn("Statistics", "Sheet");
    var onSeasons = IsOn("Seasons");
    var onPlayers = IsOn("Players");
    var onUsers = IsOn("Users");
    var onUpdate = IsOn("Update");

    // Hervorhebung wie bisher bei Matches: fett und blau.
    string NavClass(bool active) => active ? "nav-link active fw-bold text-primary" : "nav-link";
    string? Current(bool active) => active ? "page" : null;
}
<!DOCTYPE html>
<html lang="de" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PolySport</title>
    @* Das Wappen liegt als .ico mit 16, 32 und 48 Pixel vor; der Browser
       nimmt die passende Grösse. Bewusst kein SVG davor: favicon.svg zeigt
       noch den alten Entwurf und würde als rel="icon" vorgezogen. *@
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Fremd-Stylesheets (z.B. Select2) gehören hierhin: vor site.css, damit
       unsere Anpassungen sie überschreiben können und nicht umgekehrt. *@
    @await RenderSectionAsync("VendorStyles", required: false)
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PolySport.styles.css" asp-append-version="true" />
    @* Blockierend im head, damit der gespeicherte Modus vor dem ersten Rendern steht *@
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm border-bottom box-shadow mb-3 bg-body-tertiary">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">PolySport</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="@NavClass(onHome)" aria-current="@Current(onHome)" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="@NavClass(onMatches)" aria-current="@Current(onMatches)" asp-area="" asp-controller="Matches" asp-action="Index">Matches</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass(onTopScorer)" aria-current="@Current(onTopScorer)" asp-area="" asp-controller="Statistics" asp-action="Season">Top-Scorer</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass(onSheet)" aria-current="@Current(onSheet)" asp-area="" asp-controller="Statistics" asp-action="Sheet">Saisonblatt</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass(onSeasons)" aria-current="@Current(onSeasons)" asp-area="" asp-controller="Seasons" asp-action="Index">Saisons</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass(onPlayers)" aria-current="@Current(onPlayers)" asp-area="" asp-controller="Players" asp-action="Index">Spieler</a>
                            </li>
                        }
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="@NavClass(onUsers)" aria-current="@Current(onUsers)" asp-area="" asp-controller="Users" asp-action="Index">
                                    Benutzer
                                    @if (pendingApprovals > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill">@pendingApprovals</span>
                                    }
                                </a>
                            </li>
                            @if (updateAvailable)
                            {
                                <li class="nav-item">
                                    <a class="@NavClass(onUpdate)" aria-current="@Current(onUpdate)" asp-area="" asp-controller="Update" asp-action="Index">
                                        Update
                                        <span class="badge bg-warning text-dark rounded-pill">@updateInfo!.LatestVersion</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        <div class="theme-switch me-3" id="themeSwitch" title="Dark/Light Mode umschalten">
                            <div class="theme-switch__track">
                                <svg class="theme-switch__icon theme-switch__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
                                <svg class="theme-switch__icon theme-switch__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                                <div class="theme-switch__thumb"></div>
                            </div>
                        </div>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        @if (updateAvailable && !ViewContext.RouteData.Values["controller"]!.Equals("Update"))
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2 no-print">
                <span>
                    Eine neue Version ist verfügbar:
                    <strong>@updateInfo!.LatestVersion</strong>
                    (installiert: @updateInfo.CurrentVersion)
                </span>
                <a asp-controller="Update" asp-action="Index" class="btn btn-sm btn-primary">Update ansehen</a>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>&copy; 2026 - PolySport</span>
            @{
                var versionLabel = UpdateService.Cached.CurrentVersion;
                var versionKnown = !string.Equals(versionLabel, "unbekannt", StringComparison.Ordinal);
            }
            @if (isAdmin)
            {
                @* Für Admins führt die Version direkt zur Update-Seite *@
                <a asp-area="" asp-controller="Update" asp-action="Index" class="text-decoration-none"
                   title="Version prüfen und aktualisieren">
                    <span class="font-monospace small">@(versionKnown ? versionLabel : "Entwicklung")</span>
                    @if (updateAvailable)
                    {
                        <span class="badge bg-warning text-dark ms-1">Update @updateInfo!.LatestVersion</span>
                    }
                </a>
            }
            else if (versionKnown)
            {
                <span class="font-monospace small">@versionLabel</span>
            }
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>