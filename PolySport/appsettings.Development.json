{
  "ConnectionStrings": {
    // Lokale Entwicklung: SQL Server LocalDB, kommt mit Visual Studio.
    // Keine Zugangsdaten nötig, jeder Entwickler hat seine eigene DB-Datei.
    // Die Live-Datenbank wird NICHT hier hinterlegt, sondern über
    // User-Secrets bzw. Umgebungsvariable ConnectionStrings__DefaultConnection.
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=PolySport-Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
