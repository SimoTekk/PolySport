# Vorlage für die Konfiguration. Das Setup-Skript (deploy/install.sh)
# erzeugt daraus eine .env mit eigenen Werten – diese Datei nie mit
# echten Passwörtern ins Git einchecken.

# Passwort des SQL-Server-Kontos "sa".
# SQL Server verlangt mindestens 8 Zeichen mit Gross-, Kleinbuchstaben,
# Ziffer und Sonderzeichen.
MSSQL_SA_PASSWORD=BitteAendern_1234!

# Erstes Admin-Konto der Webanwendung
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=BitteAendern_1234!

# Port, unter dem die Webseite erreichbar ist
APP_PORT=8080

# Auf welcher Adresse der Port veröffentlicht wird.
# 0.0.0.0 = im ganzen Netz erreichbar
# 127.0.0.1 = nur lokal, sinnvoll wenn nginx davor läuft
BIND_ADDRESS=0.0.0.0

# Name der Datenbank
DB_NAME=PolySport

# SQL-Server-Edition: Express (kostenlos, 10 GB Limit) oder Developer
MSSQL_PID=Express

# Installierte Version. Setzen die Skripte install.sh und update.sh
# automatisch auf das ausgecheckte Release.
POLYSPORT_VERSION=

# Repository, gegen das auf neue Versionen geprüft wird
UPDATE_REPOSITORY=SimoTekk/PolySport
